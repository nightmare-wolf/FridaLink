# Private engagement scripts — kept local, never pushed to the public repo.
# Only the two generic starter files are tracked by git.
# Negation rules: ignore all of scripts/, then carve out the two public files.
scripts/*
!scripts/COMMUNITY_SCRIPTS.txt
!scripts/tls/
scripts/tls/*
!scripts/tls/ssl_unpin_bypass.js
